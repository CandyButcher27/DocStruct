__pycache__/
*.py[cod]
*$py.class

# Virtual environments & secrets
.env
.venv/
env/
venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Packaging artifacts
*.egg-info/
build/
dist/

# Logs and scratch
*.log
*.tmp
*.bak
output/
outputs/
_smoke*/

# Temporary diagnostic scripts (repo root only — tests/ stays tracked)
/debug_*.py
/run_*.py
/test_*.py
/check_*.py
/_*.py

# Local Claude Code settings (CLAUDE.md and memory/ ARE tracked)
.claude/

# Corpora and generated outputs — fetched with scripts/fetch_dataset_v2.py
data/raw-pdfs/
data/hybrid-outputs/
data/model-outputs/
data/markdown-outputs/
data/doclaynet/
data/financebench/
data/v1/
data/*.json
data/*.pdf

# Annotation review sessions (bulky, embed page images; final GT JSON is tracked)
data/annotations/_sessions/

# Model weights and HF snapshots (downloaded separately, see README)
weights/
hf_models/

# Benchmark detector/block cache (regenerated on demand, ~100MB)
.bench_cache/

# graphify code-graph output
graphify-out/

# Personal working documents, not project artifacts
interview_prep_*.md
data/ohrbench/
data/ohr_subset/
data/papers/
data/pmc/
ohr_results.zip
data/qa/pmc_sections.json
.cache/

# LaTeX build artefacts (main.pdf is committed deliberately; the rest is derived)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk

# Result bundles downloaded from Colab -- unpack into reports/ instead
docstruct_results*.zip
docstruct_gpu_results.zip
ohr_results.zip
paper/figures/*.png
dist/

# Local-only Colab upload packages (PDFs + weights, 900MB+) -- never commit
/zip/

# Per-run detector/block caches. `.bench_cache/` was already ignored, but every run
# that needs its own cache dir gets a suffix, and those were landing in git status.
.bench_cache*/

# Corpus recovered by arXiv id (320MB of PDFs, re-fetchable with the recovery script)
data/arxiv-v6/

# Overleaf upload package, rebuilt from paper/ on demand
/overleaf_upload.zip
